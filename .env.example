# Copy needed values into .env; do not overwrite existing secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/gomate
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Mapbox public (pk.) token. Shared by browser map and backend Maps APIs.
# Keep the actual token in ignored .env, never in committed files.
MAPBOX_ACCESS_TOKEN=

# Server-only VIETMAP Services key for Autocomplete v4 + Place v4.
# When configured, address lookup uses VIETMAP; map/directions still use Mapbox.
VIETMAP_API_KEY=

# Existing optional providers: supply real values locally, never commit them.
GOOGLE_CLIENT_ID=
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional process-wide Node DNS override when the default resolver fails Atlas SRV/TXT.
# Comma-separated DNS server IPs; leave blank to use the default resolver.
MONGODB_DNS_SERVERS=
